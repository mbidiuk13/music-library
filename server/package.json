{
  "name": "music-library-server",
  "version": "0.1.0",
  "private": true,
  "description": "REST API веб-застосунку «Бібліотека музичних творів» (MusicLibrary)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "node --env-file=../.env --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node --env-file=../.env src/db/migrate.js",
    "migrate:reset": "node --env-file=../.env src/db/migrate.js --reset",
    "seed": "node --env-file=../.env src/db/seed.js",
    "seed:admin": "node --env-file=../.env src/db/seed-admin.js",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "globalSetup": "<rootDir>/tests/setup/globalSetup.js",
    "setupFiles": [
      "<rootDir>/tests/setup/env.js"
    ]
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
