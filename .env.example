# Скопіюйте цей файл у .env і заповніть значення. Файл .env не потрапляє в git.
# Сервер читає його прапорцем Node.js --env-file (без пакета dotenv).

# --- Сервер ---
# Порт REST API
PORT=4000
# development | production | test
NODE_ENV=development
# Адреса клієнта: дозволене джерело для CORS і база посилань у листах
CLIENT_URL=http://localhost:5173

# --- PostgreSQL ---
# Локально відповідає docker-compose.dev.yml
DATABASE_URL=postgres://music:music@localhost:5432/music_library
# Окрема БД для автоматичних тестів (npm test): її схема створюється заново при кожному запуску,
# база створюється автоматично, якщо її немає. Без цієї змінної тести з БД пропускаються.
TEST_DATABASE_URL=postgres://music:music@localhost:5432/music_library_test

# --- JWT ---
# Довгий випадковий рядок; ніколи не комітьте справжнє значення
JWT_SECRET=change_me_to_long_random_string
# Строк дії токена доступу
JWT_EXPIRES_IN=24h

# --- AWS S3 (для розробки — окремий dev-бакет, для продакшену — свій) ---
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=music-library-audio
# Строк дії pre-signed URL для відтворення, секунд
S3_PRESIGN_TTL=3600
# Максимальний розмір аудіофайлу при завантаженні, МБ
MAX_UPLOAD_MB=50

# --- Рекомендації ---
# M — мінімум унікальних прослуханих треків для персональних рекомендацій
REC_MIN_HISTORY=5
# N — кількість персональних рекомендацій
REC_TOP_N=20
# Розмір списку «Популярне» (Топ-100)
POPULAR_LIMIT=100

# --- Адмін за замовчуванням (npm run seed:admin) ---
ADMIN_EMAIL=admin@musiclibrary.local
ADMIN_PASSWORD=
ADMIN_USERNAME=Адміністратор

# --- Пошта (необов'язково; без SMTP посилання друкується в консоль) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MusicLibrary <no-reply@musiclibrary.local>"
